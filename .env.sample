# Sample environment file for marss2l.
#
# Copy this file to `.env`, fill in real values, and load it into your shell
# (e.g. `set -a; source .env; set +a`) before running training, inference,
# or the notebook / integration tests. ALL credentials are read from the
# environment — never drop secret files into the package directory.
#
# In CI these are provided through GitHub Actions secrets. The notebook and
# train integration tests are skipped unless the env vars they depend on are
# set (see tests/conftest.py).
#
# The values below are MOCKS — replace them with your own.

# --- Weights & Biases -------------------------------------------------------
WANDB_API_KEY=0000000000000000000000000000000000000000
WANDB_PROJECT=s2l89-model

# --- Google Earth Engine ----------------------------------------------------
# GEE_SERVICE_ACCOUNT_KEY holds the full service-account JSON as a single line.
GEE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"my-project","private_key_id":"abc123","private_key":"-----BEGIN PRIVATE KEY-----\nMOCK\n-----END PRIVATE KEY-----\n","client_email":"mars-s2l@my-project.iam.gserviceaccount.com","client_id":"123456789","token_uri":"https://oauth2.googleapis.com/token"}
GEE_PROJECT=my-gee-project

# --- Azure blob storage -----------------------------------------------------
AZURE_STORAGE_ACCOUNT_NAME=mystorageaccount
AZURE_STORAGE_CONTAINER_NAME=my-container
AZURE_STORAGE_SAS_TOKEN=sv=2022-11-02&ss=b&srt=co&sp=rl&se=2030-01-01T00:00:00Z&st=2024-01-01T00:00:00Z&spr=https&sig=MOCKSIGNATUREVALUE

# --- Hugging Face -----------------------------------------------------------
# Used to access the MARS-S2L dataset (notebook + train integration tests).
HF_TOKEN=hf_0000000000000000000000000000000000
